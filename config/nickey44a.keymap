#include <dt-bindings/zmk/trackpoint_control.h>
#include <behaviors/lpps-calibration.dtsi>
#include <behaviors/trackpoint-left-ctl.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E  &kp R             &kp T                                           &kp Y    &kp U             &kp I      &kp O    &kp P     &kp AT_SIGN
&kp RSHIFT  &kp A  &kp S  &kp D  &kp F             &kp G                                           &kp H    &kp J             &kp K      &kp L    &kp SEMI  &kp MINUS
&kp LCTRL   &kp Z  &kp X  &kp C  &kp V             &kp B      &kp LEFT_WIN        &kp B            &kp N    &kp M             &kp COMMA  &kp DOT  &kp FSLH  &kp EQUAL
                                 &lt 2 LANGUAGE_2  &kp SPACE  &lt 1 LANGUAGE_1    &lt 5 BACKSPACE  &kp RET  &lt 3 LANGUAGE_1
                                                              &tpc MOUSE_MOVE     &tpc MOUSE_MOVE
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE  &kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3          &kp NUMBER_4           &kp NUMBER_5                            &kp NUMBER_6    &kp N7        &kp N8          &kp N9           &kp N0         &kp APOS
&trans      &kp F1            &kp F2             &kp F3                &kp F4                 &kp F5                                  &kp F6          &kp F7        &kp F8          &kp F9           &kp F10        &kp TILDE
&trans      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE      &mo 3     &studio_unlock  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp BACKSLASH  &kp LC(GRAVE)
                                                                       &trans                 &trans        &trans    &kp DELETE      &trans          &trans
                                                                                                            &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans     &trans      &trans  &trans                    &kp QUESTION   &trans  &trans  &trans  &kp PERCENT  &trans
&trans  &kp AT  &kp HASH   &kp DOLLAR  &trans  &trans                    &kp EXCL       &trans  &trans  &trans  &trans       &trans
&trans  &trans  &kp ASTRK  &kp CARET   &trans  &trans  &trans    &trans  &kp AMPERSAND  &trans  &trans  &trans  &trans       &trans
                                       &trans  &trans  &trans    &trans  &trans         &trans
                                                       &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &ps_calib     &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &ps_calib
                                                          &trans        &trans        &trans    &trans  &trans  &trans
                                                                                      &trans    &trans
            >;
        };

        /* Auto-activated while either TrackPoint moves (see zip_temp_layer in overlay). */

        trackpoint_layer {
            display-name = "TrackPoint";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                           &trans    &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans                           &trans    &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans     &trans      &trans    &trans    &trans    &trans  &trans  &trans  &trans
                                &mkp MB1  &mkp MCLK  &mkp MB2    &mkp MB1  &mkp MB3  &mkp MB2
                                                     &trans      &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &tp_left_ctl 1  &kp UP_ARROW    &msc SCRL_RIGHT  &kp PAGE_UP                      &kp PAGE_UP     &msc SCRL_LEFT  &kp UP_ARROW    &msc SCRL_RIGHT  &tp_left_ctl 3  &tp_left_ctl 0
&trans  &trans  &tp_left_ctl 2  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN                    &kp PAGE_DOWN   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &tp_left_ctl 4  &trans
&trans  &ps_calib  &trans          &trans          &trans           &trans         &trans    &trans  &trans         &trans          &trans          &trans              &trans  &ps_calib
                                                &trans           &trans         &trans    &trans  &trans         &trans
                                                                                &trans    &trans
            >;
        };
    };
};
